# ── LLM ─────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Banco de dados ──────────────────────────────────
# No Railway, use a variável de referência do serviço Postgres:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# No seu computador, use a URL pública do Postgres do Railway (ou um Postgres local):
DATABASE_URL=postgresql://usuario:senha@host:porta/banco
DB_POOL_MAX=5

# ── API ─────────────────────────────────────────────
# Sites que podem chamar a API pelo navegador (separados por vírgula)
ALLOWED_ORIGINS=https://inter-agente.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# Versão do aviso de privacidade aceito (mude quando o texto mudar)
CONSENTIMENTO_VERSAO=v1-2026-10

# Senha da rota de depuração /api/admin/sessao/{id}. Vazio = rota desligada.
ADMIN_TOKEN=

# 1 = liga a documentação automática em /docs (deixe vazio em produção)
ENABLE_DOCS=
